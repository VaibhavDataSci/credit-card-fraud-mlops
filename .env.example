# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with your local values.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# MLflow Tracking & Model Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=credit-card-fraud-detection
MLFLOW_REGISTERED_MODEL_NAME=CreditCardFraudDetector

# Data Paths
DATA_RAW_PATH=data/raw/creditcard.csv
DATA_PROCESSED_PATH=data/processed/cleaned.csv

# Model & Monitoring Settings
DRIFT_THRESHOLD=0.05

# Database Configuration (Optional / MLflow Backend Store)
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_postgres_database_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# AWS / Cloud Storage (Optional / DVC Remote Storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name
